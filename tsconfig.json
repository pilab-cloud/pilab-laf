{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@pilab/laf": ["./lib/index.ts"] }
  },
  "include": ["lib", "tests", "playground"]
}
