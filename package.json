{
  "name": "@pilab/laf",
  "version": "0.1.0",
  "description": "Pilab Look & Feel — React component kit",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locales/hu": {
      "types": "./dist/locales/hu.d.ts",
      "import": "./dist/locales/hu.js",
      "require": "./dist/locales/hu.cjs"
    },
    "./styles.css": "./dist/app.css"
  },
  "files": ["dist", "fonts"],
  "scripts": {
    "dev": "bun run css && concurrently -k -n css,vite \"bun run css:watch\" \"vite --config playground/vite.config.ts\"",
    "css": "tailwindcss -i ./src/app.css -o ./dist/app.css --minify && tailwindcss -i ./src/guide.css -o ./dist/guide.css --minify",
    "css:watch": "tailwindcss -i ./src/app.css -o ./dist/app.css --watch",
    "build": "bun run css && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "bun run css && cp dist/app.css ../3so/shadow-sso/api/webauth/static/app.css && cp fonts/* ../3so/shadow-sso/api/webauth/static/fonts/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^1.71.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
