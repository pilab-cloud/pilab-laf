{
  "name": "@pilab/laf",
  "version": "1.0.0",
  "description": "Pilab Look & Feel \u2014 React component kit",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./dnd": {
      "types": "./dist/dnd.d.ts",
      "import": "./dist/dnd.js",
      "require": "./dist/dnd.cjs"
    },
    "./topology": {
      "types": "./dist/topology.d.ts",
      "import": "./dist/topology.js",
      "require": "./dist/topology.cjs"
    },
    "./os-icons": {
      "types": "./dist/os-icons.d.ts",
      "import": "./dist/os-icons.js",
      "require": "./dist/os-icons.cjs"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/console.js",
      "require": "./dist/console.cjs"
    },
    "./locales/hu": {
      "types": "./dist/locales/hu.d.ts",
      "import": "./dist/locales/hu.js",
      "require": "./dist/locales/hu.cjs"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js",
      "require": "./dist/locales/*.cjs"
    },
    "./styles.css": "./dist/app.css"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "dev": "bun run css && concurrently -k -n css,vite \"bun run css:watch\" \"vite --config playground/vite.config.ts\"",
    "css": "tailwindcss -i ./src/app.css -o ./dist/app.css --minify && tailwindcss -i ./src/guide.css -o ./dist/guide.css --minify",
    "css:watch": "tailwindcss -i ./src/app.css -o ./dist/app.css --watch",
    "build": "bun run css && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "bun run css && cp dist/app.css ../3so/shadow-sso/api/webauth/static/app.css && cp fonts/* ../3so/shadow-sso/api/webauth/static/fonts/",
    "e2e": "playwright test",
    "e2e:update": "playwright test --project=visual-1x --project=visual-2x --update-snapshots"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
